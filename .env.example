# Copy to .env and edit. Every value below is the built-in default, so an empty
# .env gives you the zero-setup path: local embedder + mock chat + in-memory store,
# no API keys, no database.

# ---------------------------------------------------------------- providers
# local  = deterministic hashed n-gram embedder, no API key (default)
# openai = text-embedding-3-small
EMBEDDER_PROVIDER=local

# mock      = deterministic extractive answerer, no API key (default)
# anthropic = Claude via the Messages API
# openai    = OpenAI chat completions (or any OpenAI-compatible endpoint)
CHAT_PROVIDER=mock

# memory   = in-process, brute-force cosine + in-process BM25 (default)
# pgvector = Postgres + pgvector, HNSW cosine index, BM25 in SQL
VECTOR_STORE=memory

# ---------------------------------------------------------------- embedder
LOCAL_EMBEDDING_DIM=512
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Matryoshka truncation; omit to use the model default (1536 for -3-small).
# OPENAI_EMBEDDING_DIM=1536
EMBED_BATCH_SIZE=64
EMBED_CONCURRENCY=4

# ---------------------------------------------------------------- chat
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0

# ---------------------------------------------------------------- stores
# Matches docker-compose.yml.
# DATABASE_URL=postgres://docsrag:docsrag@localhost:5432/docsrag
MEMORY_INDEX_PATH=.docs-rag/index.json
MIGRATIONS_DIR=migrations
# HNSW search breadth. Higher = better recall, slower queries. Must be >= top-k.
PGVECTOR_EF_SEARCH=100

# ---------------------------------------------------------------- chunking
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=700
CHUNK_MIN_TOKENS=120
CHUNK_OVERLAP_TOKENS=60

# ---------------------------------------------------------------- retrieval
RAG_TOP_K=6
# Candidates each retriever contributes before fusion.
RAG_CANDIDATE_K=30
# Set RAG_SPARSE_WEIGHT=0 for pure vector search, RAG_DENSE_WEIGHT=0 for pure BM25.
RAG_DENSE_WEIGHT=1
RAG_SPARSE_WEIGHT=1
# Reciprocal Rank Fusion damping constant.
RAG_RRF_K=60
# LLM-as-reranker. Costs one extra model round-trip per question.
RAG_RERANK=false
RAG_RERANK_TOP_N=20
# Below this retrieval confidence, refuse to answer instead of guessing.
RAG_MIN_CONFIDENCE=0.30

# ---------------------------------------------------------------- answering
RAG_CONTEXT_TOKENS=6000
RAG_MAX_SOURCES=8

# ---------------------------------------------------------------- runtime
DOCS_DIR=sample-docs
LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080
